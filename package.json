{
  "name": "smooth-af-driving",
  "version": "0.75.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --mode development",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cap:sync": "npm run build && cap sync && npm run ios:privacy",
    "cap:ios": "npm run build && cap sync ios && npm run ios:privacy && cap open ios",
    "cap:icons": "capacitor-assets generate --assetPath assets",
    "ios:privacy": "bash scripts/ios-privacy.sh"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@vapi-ai/web": "^3.0.1",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0",
    "@vitest/coverage-v8": "^2.0.0",
    "jsdom": "^24.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
